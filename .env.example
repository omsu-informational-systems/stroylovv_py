# ==============================================================================
# Шаблон переменных окружения сервиса Breakout Strategy
# Скопируйте этот файл в .env и заполните своими данными.
# ВНИМАНИЕ: никогда не коммитьте заполненный файл .env в Git!
# ==============================================================================

# --- HTTP-сервер и логирование ---
APP__NAME=breakout-strategy
APP__VERSION=1.0.0
APP__HOST=0.0.0.0
APP__PORT=8000
LOG_LEVEL=INFO

# --- Подключение к защищённой Kafka платформы (SASL_SSL + SCRAM-SHA-256) ---
KAFKA_BOOTSTRAP_SERVERS=omsu.7bits.it:9094
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# Ключ выданной пары (используется как логин Kafka)
KAFKA_USERNAME=<ваш-ключ-пары>
# Секрет выданной пары (используется только как пароль Kafka, не передаётся в JSON!)
KAFKA_PASSWORD=<ваш-секрет-пары>
# Опционально: путь к доверенному набору CA-сертификатов, если системный не найден
# KAFKA_CA_LOCATION=/etc/ssl/certs/ca-certificates.crt

# --- Идентификация сервиса, аккаунта и стратегии (стабильные при перезапуске) ---
# Ключ пары для поля secretKey в JSON-сообщениях (совпадает с KAFKA_USERNAME, НЕ секрет!)
ACCOUNT_SECRET_KEY=<ваш-ключ-пары>
ACCOUNT_ID=ivanov-ii
ACCOUNT_NAME=Иванов Иван Иванович
# Учебная группа (НЕ техническая группа Kafka)
GROUP_ID=group-1
STRATEGY_ID=hybrid-breakout-ivanov
STRATEGY_NAME=Hybrid Breakout & Pairs Strategy
SERVICE_NAME=breakout-strategy
SERVICE_DESCRIPTION=Автоматизированный сервис торговой стратегии пробоя каналов Дончяна и парного арбитража
SCHEMA_VERSION=1.0

# --- Техническая группа Kafka и темы ---
# Уникальный префикс группы вашего сервиса (создаст <KAFKA_GROUP_ID>.answers и <KAFKA_GROUP_ID>.candles)
KAFKA_GROUP_ID=strategy-breakout-your-account-v1
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false

# Тема свечей, согласованная с преподавателем
CANDLE_TOPIC=market.candle.default
TOPIC_REGISTRATION_REQUEST=account.registration.request
TOPIC_REGISTRATION_RESULT=account.registration.result
TOPIC_HEARTBEAT=account.service.heartbeat
TOPIC_RECOMMENDATION_CREATED=strategy.recommendation.created
TOPIC_RECOMMENDATION_RESULT=strategy.recommendation.result

# --- Интервалы и таймауты ---
HEARTBEAT_INTERVAL_SECONDS=5
REGISTRATION_TIMEOUT_SECONDS=30
KAFKA_ASSIGNMENT_TIMEOUT_SECONDS=30
KAFKA_FLUSH_TIMEOUT_SECONDS=5.0

# --- Параметры торговой стратегии ---
# Допустимые значения: hybrid | pairs | donchian
STRATEGY_TYPE=hybrid
STRATEGY_WINDOW=20
DEFAULT_ORDER_QUANTITY=1

# Параметры парного трейдинга (при STRATEGY_TYPE=pairs)
PAIRS_PRIMARY_TICKER=T
PAIRS_BENCHMARK_TICKER=SBER
PAIRS_WINDOW=30
PAIRS_Z_ENTRY=1.8
PAIRS_Z_EXIT=0.5

# Параметры гибридной стратегии (при STRATEGY_TYPE=hybrid)
HYBRID_PRIMARY_TICKER=T
HYBRID_BENCHMARK_TICKER=SBER
HYBRID_MOMENTUM_TICKER=OZON
HYBRID_DONCHIAN_WINDOW=20
HYBRID_PAIRS_WINDOW=30
HYBRID_Z_ENTRY=1.8
HYBRID_Z_EXIT=0.5
HYBRID_VOLUME_MULTIPLIER=1.25
